#!name = BiliBili CDN 重定向
#!desc = 把 B 站港澳台/海外分片 CDN 重定向到国内镜像，改善挂代理或免流节点看视频卡顿。\n卡的时候换个 CDN 试试就行。
#!author = DeerFishSheep
#!homepage = https://github.com/DeerFishSheep/Loon
#!system = iOS,iPadOS,tvOS,macOS
#!system_version = 15
#!date = 2026-11-09
#!tag = BiliBili,重定向

[Argument]
VideoCDN = select,"阿里云 CDN","腾讯云 CDN","华为云 CDN","融合 CDN（08c）",type=string,tag=视频 CDN,desc=所有视频分片都走这个 CDN。哪个卡就换一个试试，默认阿里云。

[General]
force-http-engine-hosts = upos-sz-mirror*.bilivideo.com:80, cn-hk-eq-*.bilivideo.com:80, upos-*-mirrorakam.akamaized.net:80, *.mcdn.bilivideo.cn:8000, *.mcdn.bilivideo.cn:8082, *:4480, *:4483, *:9102

[Script]
http-request ^https?:\/\/[^\/]+\.(?:bilivideo\.com|bilivideo\.cn|akamaized\.net)(?::\d+)?\/(?:v1\/resource\/)?upgcxcode\/ script-path=https://cdn.jsdelivr.net/gh/DeerFishSheep/Loon@main/js/bilibili_cdn_redirect.js, argument="VideoCDN=${VideoCDN}", timeout=10, tag=📺 BiliBili.Redirect.CDN
http-request ^https?:\/\/\d{1,3}(?:\.\d{1,3}){3}:8000\/v1\/resource\/upgcxcode\/ script-path=https://cdn.jsdelivr.net/gh/DeerFishSheep/Loon@main/js/bilibili_cdn_redirect.js, argument="VideoCDN=${VideoCDN}", timeout=10, tag=📺 BiliBili.Redirect.PCDN.raw
http-request ^https?:\/\/[^\/:]+:4480\/upgcxcode\/ script-path=https://cdn.jsdelivr.net/gh/DeerFishSheep/Loon@main/js/bilibili_cdn_redirect.js, argument="VideoCDN=${VideoCDN}", timeout=10, tag=📺 BiliBili.Redirect.MCDN.4480

[MITM]
hostname = upos-sz-mirror*.bilivideo.com, cn-hk-eq-*.bilivideo.com, upos-*-mirrorakam.akamaized.net, *.mcdn.bilivideo.cn
