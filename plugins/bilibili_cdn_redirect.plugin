#!name = BiliBili CDN 重定向
#!desc = 把 B 站港澳台/海外分片 CDN 重定向到国内镜像，改善挂代理或免流节点看视频卡顿。\n支持 B 站内 Enhanced 面板配置，面板优先级高于 Loon 参数。
#!author = DeerFishSheep
#!homepage = https://github.com/DeerFishSheep/Loon
#!system = iOS,iPadOS,tvOS,macOS
#!system_version = 15
#!date = 2026-11-09
#!tag = BiliBili,重定向

[Argument]
OverseaCDN = select,"upos-sz-mirrorali.bilivideo.com","upos-sz-mirrorcos.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirrorhwo1.bilivideo.com","upos-sz-mirror08c.bilivideo.com",type=string,tag=港澳台 CDN,desc=OverseaVideo 分片重定向目标，默认阿里云。面板里改过的话以面板为准。
BStarCDN = select,"upos-sz-mirrorali.bilivideo.com","upos-sz-mirrorcos.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirrorhwo1.bilivideo.com","upos-sz-mirror08c.bilivideo.com",type=string,tag=国际版 CDN,desc=BStar 分片重定向目标，默认阿里云。
PCDNCDN = select,"upos-sz-mirrorali.bilivideo.com","upos-sz-mirrorcos.bilivideo.com","upos-sz-mirrorhw.bilivideo.com","upos-sz-mirror08c.bilivideo.com",type=string,tag=PCDN 兜底 CDN,desc=mcdn 与裸 IP:8000 分片的重定向目标，默认阿里云。
MCDN = select,"proxy-tf-all-ws.bilivideo.com",type=string,tag=MCDN 代理,desc=4480 端口 MCDN 请求的重定向目标。

[General]
force-http-engine-hosts = upos-sz-mirror*.bilivideo.com:80, cn-hk-eq-*.bilivideo.com:80, upos-*-mirrorakam.akamaized.net:80, *.mcdn.bilivideo.cn:8000, *.mcdn.bilivideo.cn:8082, *:4480, *:4483, *:9102

[Rewrite]
# B 站内 Enhanced 面板靠这个 mock 发现我们，去掉它入口就没了
response if ${url} ~= /^https:\/\/(?:biliverse\.github\.io|app\.bilibili\.com)\/api\/Redirect(?:\?.*)?$/ then response.body.mock_file("json", "https://raw.githubusercontent.com/DeerFishSheep/Loon/main/plugins/bilibili_cdn_redirect.panes.json", 200) | response.header.add(["X-PreferencePanes-Version", "Cache-Control"], ["0.1.0", "no-store"])

[Script]
# 港澳台 / 海外 / 国际版 / PCDN / MCDN 分片统一交给脚本判断，取值优先读面板
http-request ^https?:\/\/[^\/]+\.(?:bilivideo\.com|bilivideo\.cn|akamaized\.net)(?::\d+)?\/(?:v1\/resource\/)?upgcxcode\/ script-path=https://raw.githubusercontent.com/DeerFishSheep/Loon/main/js/bilibili_cdn_redirect.js, argument="OverseaCDN=${OverseaCDN},BStarCDN=${BStarCDN},PCDNCDN=${PCDNCDN},MCDN=${MCDN}", timeout=10, tag=📺 BiliBili.Redirect.CDN
http-request ^https?:\/\/\d{1,3}(?:\.\d{1,3}){3}:8000\/v1\/resource\/upgcxcode\/ script-path=https://raw.githubusercontent.com/DeerFishSheep/Loon/main/js/bilibili_cdn_redirect.js, argument="OverseaCDN=${OverseaCDN},BStarCDN=${BStarCDN},PCDNCDN=${PCDNCDN},MCDN=${MCDN}", timeout=10, tag=📺 BiliBili.Redirect.PCDN.raw
http-request ^https?:\/\/[^\/:]+:4480\/upgcxcode\/ script-path=https://raw.githubusercontent.com/DeerFishSheep/Loon/main/js/bilibili_cdn_redirect.js, argument="OverseaCDN=${OverseaCDN},BStarCDN=${BStarCDN},PCDNCDN=${PCDNCDN},MCDN=${MCDN}", timeout=10, tag=📺 BiliBili.Redirect.MCDN.4480

[MITM]
hostname = app.bilibili.com, biliverse.github.io, upos-sz-mirror*.bilivideo.com, cn-hk-eq-*.bilivideo.com, upos-*-mirrorakam.akamaized.net, *.mcdn.bilivideo.cn
