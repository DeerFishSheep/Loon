#!name = BiliBili CDN 重定向
#!desc = 把 B 站港澳台/海外分片 CDN 重定向到国内镜像，改善挂代理或免流节点看视频卡顿。\n当前固定使用阿里云镜像，要换 CDN 改插件里那一行域名就行。
#!author = DeerFishSheep
#!homepage = https://github.com/DeerFishSheep/Loon
#!system = iOS,iPadOS,tvOS,macOS
#!system_version = 15
#!date = 2026-11-09
#!tag = BiliBili,重定向

[General]
force-http-engine-hosts = upos-sz-mirror*.bilivideo.com:80, cn-hk-eq-*.bilivideo.com:80, upos-*-mirrorakam.akamaized.net:80, *.mcdn.bilivideo.cn:8000, *.mcdn.bilivideo.cn:8082, *:4480, *:4483, *:9102

[Rewrite]
# 港澳台 / 海外分片（OverseaVideo）：换掉主机名，协议、路径、签名参数全部保留
request if ${url} ~= /^(https?:\/\/)(upos-hz-mirrorakam\.akamaized\.net|upos-sz-mirrorakam\.akamaized\.net|upos-sz-mirror[a-z0-9-]*ov\.bilivideo\.com|cn-hk-eq-[a-z0-9-]+\.bilivideo\.com)(\/.*)$/ as m then url.replace("${m.1}upos-sz-mirrorali.bilivideo.com${m.3}")

# 国际版分片（BStar）
request if ${url} ~= /^(https?:\/\/)(upos-sz-mirror[a-z0-9-]*bstar1\.bilivideo\.com|upos-bstar1-mirrorakam\.akamaized\.net)(\/.*)$/ as m then url.replace("${m.1}upos-sz-mirrorali.bilivideo.com${m.3}")

# PCDN：mcdn 域名和裸 IP:8000，路径里多一层 /v1/resource，替换时剥掉
request if ${url} ~= /^(https?:\/\/)([a-z0-9-]+\.mcdn\.bilivideo\.cn(?::\d+)?|\d{1,3}(?:\.\d{1,3}){3}:8000)\/v1\/resource(\/upgcxcode\/.*)$/ as m then url.replace("${m.1}upos-sz-mirrorali.bilivideo.com${m.3}")

# MCDN：4480 端口的走 B 站自己的 WebSocket 代理
request if ${url} ~= /^(https?:\/\/)[^\/:]+:4480(\/upgcxcode\/.*)$/ as m then url.replace("${m.1}proxy-tf-all-ws.bilivideo.com${m.2}")
