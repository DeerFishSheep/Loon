#!name=B站大肥鱼评论过滤
#!desc=「v1.8.5」识别并删除 B 站 App 评论区里的 AI 大肥鱼。按昵称、等级、认证、大会员、评论文本综合打分，接近阈值的再拉头像算「鲸鱼蓝」占比复核；连带删除「@大肥鱼」的召唤评论和楼中楼里的小鱼。只在本地生效。
#!author=DeerFishSheep
#!date=2026-11-05 14:58:34
#!tag=B站,去广告,评论区
#!input = ownerName
#!input = threshold
#!select = avatarCheck,true,false
#!select = atDelete,false,true

[Script]
# > 大肥鱼 · 评论过滤
http-response ^https?:\/\/grpc\.biliapi\.net\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList script-path=https://raw.githubusercontent.com/DeerFishSheep/Loon/5cd2707/js/dafeiyu_comment_filter.js, requires-body=true, binary-body-mode=true, timeout=10, tag=大肥鱼过滤

[Mitm]
hostname = grpc.biliapi.net
