#!name=B站大肥鱼评论过滤
#!desc=识别并删除 B 站 App 评论区里的 AI 大肥鱼。按昵称、等级、认证、大会员、评论文本综合打分，超过阈值就地删除；连带删除「@大肥鱼」的召唤评论和楼中楼里的小鱼。只在本地生效，不举报、不改账号数据。
#!author=DeerFishSheep
#!input = ownerName

[Script]
# > 大肥鱼 · 评论过滤
http-response ^https?:\/\/grpc\.biliapi\.net\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList script-path=https://raw.githubusercontent.com/DeerFishSheep/Loon/main/js/dafeiyu_comment_filter.js, requires-body=true, binary-body-mode=true, timeout=10, tag=大肥鱼过滤

[MITM]
hostname = grpc.biliapi.net
