#!name=B站大肥鱼评论过滤
#!desc=「v1.8.7」识别并删除 B 站 App 评论区里的 AI 大肥鱼。按昵称、等级、认证、大会员、评论文本综合打分，接近阈值的再拉头像算「鲸鱼蓝」占比复核；连带删除「@大肥鱼」的召唤评论和楼中楼里的小鱼。只在本地生效。
#!author=DeerFishSheep
#!date=2026-11-05 15:03:43
#!tag=B站,去广告,评论区
#!input = 你的B站昵称
#!input = 删除阈值
#!select = 头像识别,true,false
#!select = 包含@就删,true,false

[Script]
# > 大肥鱼 · 评论过滤
http-response ^https?:\/\/grpc\.biliapi\.net\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList script-path=https://raw.githubusercontent.com/DeerFishSheep/Loon/1da73bb/js/dafeiyu_comment_filter.js, requires-body=true, binary-body-mode=true, timeout=10, tag=大肥鱼过滤

[Mitm]
hostname = grpc.biliapi.net
