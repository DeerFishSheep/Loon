#!name=B站大肥鱼评论·链路测试
#!desc=拦截 B 站 App 评论区 gRPC 接口（Reply/MainList），把当前页第一条评论的文字改成测试文案，其余字段原样保留。用途是验证 protobuf 解析与写回链路，不参与任何打分过滤。
#!author=DeerFishSheep

[Script]
# > 大肥鱼 · 链路测试：只改第一条评论的文字
http-response ^https?:\/\/grpc\.biliapi\.net\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList script-path=https://raw.githubusercontent.com/DeerFishSheep/Loon/main/js/dafeiyu_comment_test.js, requires-body=true, binary-body-mode=true, timeout=10, tag=大肥鱼链路测试

[MITM]
hostname = grpc.biliapi.net
